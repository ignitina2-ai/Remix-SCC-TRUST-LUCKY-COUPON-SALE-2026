rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global safety net catch-all
    match /{document=**} {
      allow read, write: if false;
    }
    
    // Helper function to check if the user is authenticated with a valid email
    function isAuthenticated() {
      return request.auth != null;
    }

    // Transactions
    match /transactions/{transactionId} {
      allow read, write: if isAuthenticated();
    }

    // Sponsors
    match /sponsors/{sponsorId} {
      allow read, write: if isAuthenticated();
    }

    // Income and Expenses
    match /incomeExpenses/{incomeExpenseId} {
      allow read, write: if isAuthenticated();
    }

    // Secretary Handovers
    match /secretaryHandovers/{secretaryHandoverId} {
      allow read, write: if isAuthenticated();
    }

    // App Settings
    match /settings/{settingsId} {
      allow read, write: if isAuthenticated();
    }

    // Allowed Users (Whitelist Registry)
    match /allowedUsers/{emailId} {
      allow read, write: if isAuthenticated();
    }

    // Test connection
    match /test/{testId} {
      allow read, write: if isAuthenticated();
    }
  }
}
